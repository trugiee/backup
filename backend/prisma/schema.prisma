generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id                           String   @id @default(uuid())
  name                         String
  email                        String   @unique
  password                     String
  role                         String   @default("admin")
  createdAt                    DateTime @default(now())
  theme                        String   @default("light")
  paymentEnabled               Boolean  @default(true)
  achievementsEnabled          Boolean  @default(true)
  collectorRegistrationEnabled Boolean  @default(true)
}

model Collector {
  id                 String        @id @default(uuid())
  name               String
  email              String?       @unique
  password           String?
  phone              String?
  address            String?
  createdAt          DateTime      @default(now())
  bio                String?
  isPendingExhibitor Boolean       @default(false)
  profilePicture     String?
  theme              String        @default("light")
  messagesSent       Message[]     @relation("CollectorMessages")
  soldArtworks       SoldArtwork[]
}

model Exhibitor {
  id                  String               @id @default(uuid())
  name                String
  email               String?              @unique
  phone               String?
  address             String?
  createdAt           DateTime             @default(now())
  password            String?
  bio                 String?
  profilePicture      String?
  theme               String               @default("light")
  achievements        Achievement[]
  artworks            Artwork[]
  contributedArtworks ArtworkContributor[]
  messagesReceived    Message[]            @relation("ExhibitorMessages")
  payments            Payment[]
}

model Artwork {
  id           String               @id @default(uuid())
  title        String
  type         String
  yearCreated  Int?
  style        String?
  description  String?
  price        Float?
  status       String               @default("Available")
  imageUrl     String?
  attributes   Json?
  createdAt    DateTime             @default(now())
  exhibitorId  String?
  media        Json                 @default("[]")
  exhibitor    Exhibitor?           @relation(fields: [exhibitorId], references: [id])
  contributors ArtworkContributor[]
  payments     Payment[]
  sales        SoldArtwork[]
}

model ArtworkContributor {
  artworkId   String
  exhibitorId String
  artwork     Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id])

  @@id([artworkId, exhibitorId])
}

model SoldArtwork {
  id           String     @id @default(uuid())
  collectorId  String?
  artworkId    String
  artworkTitle String
  salePrice    Float
  saleDate     DateTime   @default(now())
  notes        String?
  createdAt    DateTime   @default(now())
  artwork      Artwork    @relation(fields: [artworkId], references: [id])
  collector    Collector? @relation(fields: [collectorId], references: [id])
}

model Achievement {
  id            String    @id @default(uuid())
  title         String
  description   String?
  year          Int?
  proofImageUrl String?
  proofLink     String?
  isVerified    Boolean   @default(false)
  exhibitorId   String
  createdAt     DateTime  @default(now())
  exhibitor     Exhibitor @relation(fields: [exhibitorId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  target    String
  createdAt DateTime @default(now())
  userId    String?

  @@index([userId])
}

model Payment {
  id                 String     @id @default(uuid())
  artworkId          String?
  amount             Float      @default(5)
  status             String     @default("pending")
  paymongoCheckoutId String?
  paymongoPaymentId  String?
  checkoutUrl        String?
  createdAt          DateTime   @default(now())
  paidAt             DateTime?
  exhibitorId        String?
  artwork            Artwork?   @relation(fields: [artworkId], references: [id])
  exhibitor          Exhibitor? @relation(fields: [exhibitorId], references: [id])

  @@index([exhibitorId])
  @@index([artworkId])
  @@index([status])
}

model Message {
  id          String    @id @default(uuid())
  content     String
  senderRole  String
  exhibitorId String
  collectorId String
  artworkId   String?
  artworkType String?
  createdAt   DateTime  @default(now())
  collector   Collector @relation("CollectorMessages", fields: [collectorId], references: [id])
  exhibitor   Exhibitor @relation("ExhibitorMessages", fields: [exhibitorId], references: [id])
}

model Report {
  id         String    @id @default(uuid())
  userId     String
  userRole   String
  subject    String
  message    String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}
