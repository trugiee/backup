# Copy this file to .env and fill in the values

# ─── Database (PostgreSQL) ─────────────────────────────────────
# Get from: Supabase / Neon / Railway Postgres / any PostgreSQL host
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ─── PayMongo (Payments) ───────────────────────────────────────
# Get from: https://dashboard.paymongo.com → Developers → API Keys
PAYMONGO_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxx

# ─── Frontend URL (CORS) ───────────────────────────────────────
# Your deployed frontend domain (no trailing slash)
FRONTEND_URL=https://your-frontend-domain.com

# ─── Email (Gmail SMTP) ───────────────────────────────────────
# Use a Gmail App Password (not your real password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password_here

# ─── Gemini AI ────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
