{
  "name": "ggallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:strip-apk": "node -e \"require('fs').rmSync('dist/ggallery.apk',{force:true})\"",
    "cap:sync": "npm run cap:strip-apk && cd ../mobile && npx cap sync",
    "cap:copy": "npm run cap:strip-apk && cd ../mobile && npx cap copy",
    "cap:open": "cd ../mobile && npx cap open android",
    "cap:build": "npm run cap:verify-version && npm run build && npm run cap:strip-apk && cd ../mobile && npx cap build android",
    "cap:verify-version": "node ../scripts/ota.mjs verify",
    "release:ota": "npm run build && node ../scripts/ota.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capgo/capacitor-updater": "^8.51.25",
    "@tailwindcss/vite": "^4.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.9.2",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
